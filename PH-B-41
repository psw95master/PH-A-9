## 3. 설치

손앞 맥의 `~/.zshrc` 에 아래 함수를 통째로 붙여넣는다. 그리고 새 터미널 창을 열거나 `source ~/.zshrc`.

```zsh
# 원격 맥 터미널 — 세션은 tmux로 유지되어 창을 닫아도 살아있음
# cerryde        : 새 세션 생성 (cerryde-1, cerryde-2, ... 자동 번호)
# cerryde list   : 세션 목록
# cerryde 1      : cerryde-1 세션에 재접속
# cerryde claude : 새 세션 + 클로드코드를 리모트컨트롤(웹/폰 연결) 켠 채로 실행
# cerryde kill 1   : cerryde-1 세션 종료
# cerryde kill all : 모든 세션 종료
# cerryde keep 1   : cerryde-1만 남기고 나머지 전부 종료
cerryde() {
  local tmux=/usr/local/bin/tmux
  case "$1" in
    list)
      ssh 19macbook "$tmux ls 2>/dev/null || echo '활성 세션 없음'" ;;
    kill)
      if [[ "$2" == all ]]; then
        ssh 19macbook "$tmux ls -F '#{session_name}' 2>/dev/null | grep '^cerryde-' | xargs -n1 $tmux kill-session -t; echo '모든 세션 종료 완료'"
      else
        ssh 19macbook "$tmux kill-session -t cerryde-$2"
      fi ;;
    keep)
      ssh 19macbook "$tmux ls -F '#{session_name}' 2>/dev/null | grep '^cerryde-' | grep -vx 'cerryde-$2' | xargs -n1 $tmux kill-session -t; echo '--- 남은 세션 ---'; $tmux ls 2>/dev/null || echo '활성 세션 없음'" ;;
    "")
      ssh -t 19macbook "n=1; while $tmux has-session -t cerryde-\$n 2>/dev/null; do n=\$((n+1)); done; $tmux new-session -s cerryde-\$n" ;;
    claude)
      # 홈에서 띄우면 신뢰 확인 창이 매번 떠서(홈은 신뢰가 저장 안 됨) 자동 웹창이 막힌다
      local n log s url r dir="${CERRYDE_CLAUDE_DIR:-\$HOME/projects}"
      # 1) 빈 번호를 받아 세션을 백그라운드로 띄운다
      n=$(ssh -n 19macbook "n=1; while $tmux has-session -t cerryde-\$n 2>/dev/null; do n=\$((n+1)); done; echo \$n")
      [[ -z "$n" ]] && { echo "원격 맥 연결 실패"; return 1; }
      log="/tmp/cerryde-rc-$n.log"
      ssh -n 19macbook "$tmux new-session -d -x 200 -y 50 -s cerryde-$n \"cd $dir && \$HOME/.local/bin/claude --remote-control --debug-file $log\""
      # 2) 세션 주소가 로그에 뜰 때까지 기다렸다가 손앞 맥 브라우저로 연다.
      #    백그라운드(&)로 돌리면 ssh가 터미널 입력을 붙잡으려다 정지해 버린다 — 반드시 앞에서 처리할 것.
      #    ssh -n 도 같은 이유(stdin 차단). 260812에 이걸로 한 번 깨졌다.
      printf 'cerryde-%s 준비 중… ' "$n"
      s=$(ssh -n 19macbook "for i in \$(seq 1 45); do
            h=\$(grep -oE 'sessions/cse_[A-Za-z0-9]+' $log 2>/dev/null | head -1)
            if [ -n \"\$h\" ]; then echo \"\$h\"; exit 0; fi
            sleep 1
          done")
      if [[ -n "$s" ]]; then
        url="https://claude.ai/code/session_${s#sessions/cse_}"
        echo "세션 창 여는 중"
        # 크롬 앱 창(탭·주소창 없는 독립 창)으로 연다. 창 제목은 "Claude Code".
        # ⚠️ claude.ai 가 크롬에 앱으로 설치돼 있으면, --app= 만 쓸 때 그런 창이 이미
        #    떠 있으면 새 세션을 열지 않고 '옛 창을 앞으로 가져오기만' 한다.
        #    그래서 지난 세션 화면이 그대로 보인다 (260820 실측). 기존 창이 있으면
        #    주소를 새 세션으로 바꿔주고, 하나도 없을 때만 새 창을 띄운다.
        # 사파리로 되돌리려면 아래 블록 전체를 이 한 줄로 바꾼다:
        #   open -a Safari "$url"
        r=$(osascript - "$url" <<'OSA' 2>/dev/null
on run argv
  set u to item 1 of argv
  tell application "Google Chrome"
    repeat with i from 1 to (count of windows)
      if (URL of active tab of window i) contains "claude.ai/code/session_" then
        set URL of active tab of window i to u
        set index of window i to 1
        activate
        return "ok"
      end if
    end repeat
  end tell
  return "none"
end run
OSA
)
        [[ "$r" == ok ]] || open -na "Google Chrome" --args --app="$url"
      else
        echo "주소를 못 잡음 — 터미널 화면의 주소를 직접 클릭하세요"
      fi
      # 3) 터미널도 그대로 붙여준다
      ssh -t 19macbook "$tmux attach -t cerryde-$n" ;;
    *)
      ssh -t 19macbook "$tmux attach -t cerryde-$1" ;;
  esac
}
```

**고칠 곳 3개** — 다른 컴퓨터에서는 이것만 확인하면 된다.

1. `19macbook` — 원격 맥의 SSH 별명. 실제 주소는 `~/.ssh/config` 에 둔다. **이 문서에 적지 않는다.**
2. `local tmux=/usr/local/bin/tmux` — 원격 맥의 tmux 경로.
3. `CERRYDE_CLAUDE_DIR` — 세션 시작 폴더. 기본값 `~/projects`. 환경변수로 덮어쓸 수 있다.

